<UserControl x:Class="KaqiaApp.StickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="150"
             Background="Transparent"
             RenderTransformOrigin="0.5,0.5"
             Focusable="True">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="StickerScale" />
            <RotateTransform x:Name="StickerRotate" />
            <TranslateTransform x:Name="StickerTranslate" />
        </TransformGroup>
    </UserControl.RenderTransform>
    <Grid x:Name="MainGrid">
        <!-- The Actual Image -->
        <Image x:Name="StickerImage" Source="/cat_logo.png" Stretch="Uniform" 
               MouseDown="OnImageMouseDown" />

        <!-- Control Handles (Visible only when selected) -->
        <Canvas x:Name="ControlCanvas" Visibility="Collapsed">
            <!-- Selection Border -->
            <Rectangle Canvas.Left="0" Canvas.Top="0" 
                       Width="{Binding ActualWidth, ElementName=MainGrid}" 
                       Height="{Binding ActualHeight, ElementName=MainGrid}"
                       Stroke="#00A2FF" StrokeDashArray="2 2" StrokeThickness="1" />
            
            <!-- Resize Handle (Bottom-Right) -->
            <Ellipse x:Name="ResizeHandle" Fill="White" Stroke="#00A2FF" StrokeThickness="1"
                     Width="12" Height="12" Canvas.Right="-6" Canvas.Bottom="-6"
                     Cursor="SizeNWSE" MouseDown="OnResizeMouseDown" />

            <!-- Rotate Handle (Bottom-Center) -->
            <Ellipse x:Name="RotateHandle" Fill="White" Stroke="#FFC107" StrokeThickness="1"
                     Width="12" Height="12" Canvas.Bottom="-25" HorizontalAlignment="Center"
                     Cursor="Hand" MouseDown="OnRotateMouseDown" Margin="69,0,0,0" />
            
            <!-- Delete Button (Top-Right) -->
            <Button x:Name="DeleteButton" Content="×" Background="#FF4444" Foreground="White"
                    FontSize="10" Width="16" Height="16" Canvas.Right="-8" Canvas.Top="-8"
                    Click="OnDeleteClick" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Canvas>
    </Grid>
</UserControl>
