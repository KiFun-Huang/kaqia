<UserControl x:Class="KaqiaApp.KaqiaObjectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="100"
             RenderTransformOrigin="0.5,0.5"
             Focusable="True">
    
    <UserControl.Resources>
        <Style x:Key="ResizeHandleStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="#00A2FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <EventSetter Event="MouseDown" Handler="OnResizeHandleMouseDown"/>
        </Style>
        <Style x:Key="EdgeTriggerStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="Transparent"/>
            <EventSetter Event="MouseDown" Handler="OnResizeHandleMouseDown"/>
        </Style>
    </UserControl.Resources>
    
    <UserControl.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="ObjectRotate" />
            <TranslateTransform x:Name="ObjectTranslate" />
        </TransformGroup>
    </UserControl.RenderTransform>
    
    <Grid x:Name="MainGrid">
        <!-- The Content (Image, Shape, or Text) -->
        <ContentControl x:Name="ObjectContent" MouseDown="OnContentMouseDown" 
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Interaction Overlay -->
        <Grid x:Name="ControlCanvas" Visibility="Collapsed">
            <!-- 3x3 Grid for handles and edges -->
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <!-- Dash Border (Visual only) -->
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Stroke="#00A2FF" StrokeDashArray="3 3" StrokeThickness="2" IsHitTestVisible="False"/>
            
            <!-- Move Handles (Outer frame for dragging, center is hollow to allow click-through) -->
            <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Cursor="SizeAll" MouseDown="OnContentMouseDown" Background="{x:Null}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <!-- Outer areas capture hits for dragging. -->
                <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Fill="Transparent"/>
                <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="Transparent"/>
                <Rectangle Grid.Row="1" Grid.Column="0" Fill="Transparent"/>
                <Rectangle Grid.Row="1" Grid.Column="2" Fill="Transparent"/>
            </Grid>
            
            <!-- Edges (Specific smaller areas for resizing, centered on each side) -->
            <Rectangle x:Name="LeftHandle" Grid.Column="0" Grid.Row="1" Width="10" Height="30" VerticalAlignment="Center" Cursor="SizeWE" Style="{StaticResource EdgeTriggerStyle}" Tag="Left"/>
            <Rectangle x:Name="RightHandle" Grid.Column="2" Grid.Row="1" Width="10" Height="30" VerticalAlignment="Center" Cursor="SizeWE" Style="{StaticResource EdgeTriggerStyle}" Tag="Right"/>
            <Rectangle x:Name="TopHandle" Grid.Column="1" Grid.Row="0" Height="10" Width="30" HorizontalAlignment="Center" Cursor="SizeNS" Style="{StaticResource EdgeTriggerStyle}" Tag="Top"/>
            <Rectangle x:Name="BottomHandle" Grid.Column="1" Grid.Row="2" Height="10" Width="30" HorizontalAlignment="Center" Cursor="SizeNS" Style="{StaticResource EdgeTriggerStyle}" Tag="Bottom"/>

            <!-- Corners -->
            <Ellipse Grid.Column="0" Grid.Row="0" Cursor="SizeNWSE" Style="{StaticResource ResizeHandleStyle}" Tag="TopLeft"/>
            <Ellipse Grid.Column="2" Grid.Row="0" Cursor="SizeNESW" Style="{StaticResource ResizeHandleStyle}" Tag="TopRight"/>
            <Ellipse Grid.Column="0" Grid.Row="2" Cursor="SizeNESW" Style="{StaticResource ResizeHandleStyle}" Tag="BottomLeft"/>
            <Ellipse Grid.Column="2" Grid.Row="2" Cursor="SizeNWSE" Style="{StaticResource ResizeHandleStyle}" Tag="BottomRight"/>

            <!-- Action Buttons Layer (Using a Canvas inside the Grid for absolute positioning relative to bottom) -->
            <Canvas Grid.Row="2" Grid.Column="1" IsHitTestVisible="True">
                <!-- Rotate -->
                <Ellipse x:Name="RotateHandle" Fill="White" Stroke="#FFC107" StrokeThickness="1"
                         Width="12" Height="12" Canvas.Top="20" Canvas.Left="-6" Cursor="Hand" MouseDown="OnRotateMouseDown" />
                
                <!-- Delete (Top Right corner of the whole object) -->
                <!-- We need to reach out to the top-right, so we use negative offsets from our bottom-center cell? 
                     Better to just put it in the Grid.Column=2 Row=0 -->
            </Canvas>

            <Button x:Name="DeleteButton" Grid.Column="2" Grid.Row="0" Content="×" Background="#FF4444" Foreground="White"
                    FontSize="10" Width="18" Height="18" Margin="0,-12,-12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="OnDeleteClick" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>
