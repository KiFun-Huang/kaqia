<Window x:Class="KaqiaApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaqia Start" Height="220" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">
    <Border Background="#E61E1E1E" CornerRadius="16" BorderBrush="#444" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Kaqia 咔嚓" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,8"/>
            <TextBlock x:Name="StatusText" Text="已在后台静默运行" Foreground="#AAA" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>