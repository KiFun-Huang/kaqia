<Window x:Class="KaqiaApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaqia 设置" Height="380" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="通用设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Hotkey -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="截图快捷键" Foreground="#666" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyTextBox" IsReadOnly="True" Padding="8" 
                             Text="按下快捷键组合..." PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                    <Button Grid.Column="1" Content="清除" Click="OnClearHotkeyClick" Margin="10,0,0,0" Padding="15,0"/>
                </Grid>
            </StackPanel>

            <!-- Auto-start -->
            <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动 Kaqia" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

            <!-- Save Path -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="默认保存目录 (可选，设置后自动存至该目录)" Foreground="#666" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SavePathTextBox" IsReadOnly="True" Padding="8" />
                    <Button Grid.Column="1" Content="浏览..." Click="OnBrowseFolderClick" Margin="10,0,0,0" Padding="15,0"/>
                </Grid>
            </StackPanel>

            <Separator Margin="0,0,0,20" Background="#DDD"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Click="OnSaveClick" Width="80" Height="32" Background="#00A2FF" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button Content="取消" Click="OnCancelClick" Width="80" Height="32" Background="White" BorderBrush="#DDD"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
