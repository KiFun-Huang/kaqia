<Window x:Class="KaqiaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaqia Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" Left="0" Top="0" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CircleDeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4444"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid><Ellipse Fill="{TemplateBinding Background}"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,0"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Width" Value="40"/>
        </Style>
        <Style x:Key="ColorSwatch" TargetType="Border">
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Margin" Value="3"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#444"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="2,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="BtnBorder" Property="Background" Value="#00A2FF"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnBorder" Property="Background" Value="#444"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Image x:Name="BackgroundImg" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Path x:Name="MaskPath" Fill="#B0000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1><RectangleGeometry x:Name="FullRect" /></CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2><RectangleGeometry x:Name="SelectionRect" /></CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <Canvas x:Name="MainCanvas" Background="Transparent" MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp">
            <Rectangle x:Name="SelectionBorder" Stroke="#00A2FF" StrokeThickness="1" Visibility="Collapsed" />
            
            <Border x:Name="InfoOverlay" Visibility="Collapsed" Background="#D8000000" CornerRadius="4" Padding="6,4" Panel.ZIndex="10000">
                <StackPanel Orientation="Horizontal" TextBlock.Foreground="White" TextBlock.FontSize="12">
                    <TextBlock x:Name="InfoPosText" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <StackPanel x:Name="InfoSizePanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="InfoWidthInput" Text="100" Background="Transparent" Foreground="White" BorderThickness="0" TextAlignment="Center" MinWidth="30" GotFocus="OnInfoSizeGotFocus" LostFocus="OnInfoSizeLostFocus" KeyDown="OnInfoSizeKeyDown"/>
                        <TextBlock Text=" × " VerticalAlignment="Center" Foreground="#AAA"/>
                        <TextBox x:Name="InfoHeightInput" Text="100" Background="Transparent" Foreground="White" BorderThickness="0" TextAlignment="Center" MinWidth="30" GotFocus="OnInfoSizeGotFocus" LostFocus="OnInfoSizeLostFocus" KeyDown="OnInfoSizeKeyDown"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Canvas x:Name="EditCanvas" Visibility="Collapsed">
                <Grid x:Name="CropResizeGrid" Visibility="Collapsed" Panel.ZIndex="100">
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="TopLeft" Margin="-5,-5,0,0"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeNS" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="Top" Margin="0,-5,0,0"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="TopRight" Margin="0,-5,-5,0"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="Left" Margin="-5,0,0,0"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeWE" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="Right" Margin="0,0,-5,0"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="BottomLeft" Margin="-5,0,0,-5"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNS" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="Bottom" Margin="0,0,0,-5"/>
                    <Rectangle Width="10" Height="10" Fill="White" Stroke="#00A2FF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" MouseDown="OnCropHandleMouseDown" MouseMove="OnCropHandleMouseMove" MouseUp="OnCropHandleMouseUp" Tag="BottomRight" Margin="0,0,-5,-5"/>
                </Grid>
                <Border x:Name="ShadowLayer" Background="Transparent">
                    <Border x:Name="CanvasLayer" Background="Transparent" Padding="0">
                        <Grid x:Name="LayeredContainer">
                            <Border x:Name="ImageClipBorder" CornerRadius="0" Background="Transparent">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Background="Black" Width="{Binding ActualWidth, ElementName=LayeredContainer}" Height="{Binding ActualHeight, ElementName=LayeredContainer}" CornerRadius="{Binding CornerRadius, ElementName=ImageClipBorder}"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Canvas x:Name="ImageContainer" Background="Transparent">
                                    <Image x:Name="CroppedImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas x:Name="AnnotationCanvas" Background="Transparent" Focusable="True" />
                                </Canvas>
                            </Border>
                            <Border x:Name="StrokeLayer" BorderThickness="0" BorderBrush="White" CornerRadius="{Binding CornerRadius, ElementName=ImageClipBorder}" IsHitTestVisible="False" Background="Transparent" />
                        </Grid>
                    </Border>
                </Border>
            </Canvas>
        </Canvas>

        <!-- CONTROL LAYER (Canvas based for manual positioning) -->
        <Canvas x:Name="ControlCanvas" Background="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- TOOLBAR -->
            <Border x:Name="Toolbar" Visibility="Collapsed" Background="#F22C2C2C" Height="42" Panel.ZIndex="9999" CornerRadius="6" MouseLeftButtonDown="OnToolbarMouseDown" MouseMove="OnToolbarMouseMove" MouseLeftButtonUp="OnToolbarMouseUp">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Background="Transparent" Cursor="SizeAll" ToolTip="拖动工具栏">
                        <TextBlock Text="⋮" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Margin="2,0,0,2"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,5,0">
                        <RadioButton x:Name="SelectToolBtn" Content="↖" Style="{StaticResource ToolButton}" IsChecked="True" Tag="Select" Click="OnToolSelected" ToolTip="选择 (S)"/>
                        <RadioButton Content="□" Style="{StaticResource ToolButton}" Tag="Rectangle" Click="OnToolSelected" ToolTip="矩形 (R)"/>
                        <RadioButton Content="◯" Style="{StaticResource ToolButton}" Tag="Ellipse" Click="OnToolSelected" ToolTip="椭圆 (E)"/>
                        <RadioButton Content="➔" Style="{StaticResource ToolButton}" Tag="Arrow" Click="OnToolSelected" ToolTip="箭头 (A)"/>
                        <RadioButton Content="✎" Style="{StaticResource ToolButton}" Tag="Pen" Click="OnToolSelected" ToolTip="画笔 (P)"/>
                        <RadioButton Content="T" Style="{StaticResource ToolButton}" Tag="Text" Click="OnToolSelected" ToolTip="文字 (T)"/>
                    </StackPanel>
                    <Separator Width="1" Background="#444" Margin="5,8"/>
                    <Button Content="外观" Click="OnBeautifyToggle" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="贴纸" Click="OnStickerPickerToggle" Style="{StaticResource ToolbarButton}"/>
                    <Separator Width="1" Background="#444" Margin="5,8"/>
                    <Button Content="完成" Click="OnFinishClick" Style="{StaticResource ToolbarButton}" Background="#00C853" FontWeight="Bold" Margin="5,4" Width="60" Padding="0"/>
                    <Button Content="取消" Click="OnCancelClick" Style="{StaticResource ToolbarButton}" Background="Transparent" Foreground="#AAA" Margin="2,4,8,4" Width="60" Padding="0"/>
                </StackPanel>
            </Border>

            <!-- BEAUTIFY POPUP -->
            <Border x:Name="BeautifyPopup" Visibility="Collapsed" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="15" Width="340">
                <StackPanel>
                    <TextBlock Text="外观美化" Foreground="White" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="圆角" Style="{StaticResource SmallLabel}"/>
                        <Slider x:Name="RadiusSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Minimum="0" Maximum="50" ValueChanged="OnRadiusChanged"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0}}" Foreground="#555" VerticalAlignment="Center" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="描边" Style="{StaticResource SmallLabel}"/>
                        <Slider x:Name="StrokeSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Minimum="0" Maximum="15" ValueChanged="OnStrokeChanged"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=StrokeSlider, StringFormat={}{0:0}}" Foreground="#555" VerticalAlignment="Center" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="描边颜色" Foreground="#666" FontSize="10" Margin="45,5,0,0"/>
                    <WrapPanel Margin="45,2,0,5">
                        <Border Style="{StaticResource ColorSwatch}" Background="#F44336" MouseDown="OnStrokeColorSelected" Tag="#F44336" ToolTip="红色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#2196F3" MouseDown="OnStrokeColorSelected" Tag="#2196F3" ToolTip="蓝色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#4CAF50" MouseDown="OnStrokeColorSelected" Tag="#4CAF50" ToolTip="绿色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#FFC107" MouseDown="OnStrokeColorSelected" Tag="#FFC107" ToolTip="黄色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#9E9E9E" MouseDown="OnStrokeColorSelected" Tag="#9E9E9E" ToolTip="灰色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#333333" MouseDown="OnStrokeColorSelected" Tag="#333333" ToolTip="黑色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#FFFFFF" MouseDown="OnStrokeColorSelected" Tag="#FFFFFF" ToolTip="白色"/>
                    </WrapPanel>

                    <TextBlock Text="自定义描边" Foreground="#666" FontSize="10" Margin="45,5,0,0"/>
                    <Grid Margin="45,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" Margin="3" CornerRadius="10" Cursor="Hand" BorderBrush="#444" BorderThickness="1" MouseDown="OnCustomStrokeColorClick" ToolTip="自定义描边颜色">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0000" Offset="0.0" />
                                    <GradientStop Color="#FFFF00" Offset="0.16" />
                                    <GradientStop Color="#00FF00" Offset="0.33" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.66" />
                                    <GradientStop Color="#FF00FF" Offset="0.83" />
                                    <GradientStop Color="#FF0000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBox Grid.Column="1" x:Name="StrokeHexInput" Text="#80FFFFFF" FontSize="10" Padding="5,2" VerticalAlignment="Center" KeyDown="OnStrokeHexKeyDown" Margin="5,0,15,0"/>
                    </Grid>

                    <CheckBox x:Name="ShadowCheck" Content="启用悬浮阴影" Foreground="White" IsChecked="True" Checked="OnShadowChanged" Unchecked="OnShadowChanged" Margin="0,5,0,5"/>
                    
                    <StackPanel Visibility="{Binding IsChecked, ElementName=ShadowCheck, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                            <TextBlock Text="留白" Style="{StaticResource SmallLabel}"/>
                            <Slider x:Name="PaddingSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Minimum="0" Maximum="100" ValueChanged="OnPaddingChanged"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=PaddingSlider, StringFormat={}{0:0}}" Foreground="#555" VerticalAlignment="Center" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="底座颜色" Foreground="#666" FontSize="10" Margin="45,5,0,0"/>
                        <Grid Margin="45,2,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <WrapPanel>
                                <Border Style="{StaticResource ColorSwatch}" Background="Transparent" MouseDown="OnCanvasColorSelected" Tag="Transparent" ToolTip="无底座"/>
                                <Border Style="{StaticResource ColorSwatch}" Background="White" MouseDown="OnCanvasColorSelected" Tag="White" ToolTip="白色"/>
                                <Border Style="{StaticResource ColorSwatch}" MouseDown="OnCanvasColorSelected" Tag="Gradient1" ToolTip="渐变色">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8E2DE2" Offset="0"/><GradientStop Color="#4A00E0" Offset="1"/></LinearGradientBrush></Border.Background>
                                </Border>
                            </WrapPanel>
                            <TextBox Grid.Column="1" x:Name="CanvasHexInput" Text="#00000000" FontSize="10" Padding="2" VerticalAlignment="Center" KeyDown="OnCanvasHexKeyDown" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- TOOL PROPERTY POPUP -->
            <Border x:Name="ToolPropertyPopup" Visibility="Collapsed" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="15" Width="280">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="ToolPropertyTitle" Text="工具选项" Foreground="White" FontWeight="Bold"/>
                        <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-5,-5,0" Click="OnCloseToolPropertyClick" Background="Transparent" Foreground="#AAA" BorderThickness="0" FontSize="16" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" Padding="5,0"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ToolThicknessLabel" Text="粗细" Style="{StaticResource SmallLabel}"/>
                        <Slider x:Name="ToolThicknessSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Minimum="1" Maximum="15" Value="3" ValueChanged="OnToolParamChanged"/>
                        <TextBlock x:Name="ToolThicknessValue" Grid.Column="2" Text="{Binding Value, ElementName=ToolThicknessSlider, StringFormat={}{0:0}}" Foreground="#555" VerticalAlignment="Center" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="常用颜色" Foreground="#666" FontSize="10" Margin="45,5,0,0"/>
                    <WrapPanel Margin="45,2,0,5">
                        <Border Style="{StaticResource ColorSwatch}" Background="#F44336" MouseDown="OnToolColorSelected" Tag="#F44336" ToolTip="红色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#2196F3" MouseDown="OnToolColorSelected" Tag="#2196F3" ToolTip="蓝色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#4CAF50" MouseDown="OnToolColorSelected" Tag="#4CAF50" ToolTip="绿色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#FFC107" MouseDown="OnToolColorSelected" Tag="#FFC107" ToolTip="黄色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#9E9E9E" MouseDown="OnToolColorSelected" Tag="#9E9E9E" ToolTip="灰色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#333333" MouseDown="OnToolColorSelected" Tag="#333333" ToolTip="黑色"/>
                        <Border Style="{StaticResource ColorSwatch}" Background="#FFFFFF" MouseDown="OnToolColorSelected" Tag="#FFFFFF" ToolTip="白色"/>
                    </WrapPanel>

                    <TextBlock Text="自定义" Foreground="#666" FontSize="10" Margin="45,5,0,0"/>
                    <Grid Margin="45,2,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" Margin="3" CornerRadius="10" Cursor="Hand" BorderBrush="#444" BorderThickness="1" MouseDown="OnCustomColorClick" ToolTip="自定义颜色">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0000" Offset="0.0" />
                                    <GradientStop Color="#FFFF00" Offset="0.16" />
                                    <GradientStop Color="#00FF00" Offset="0.33" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.66" />
                                    <GradientStop Color="#FF00FF" Offset="0.83" />
                                    <GradientStop Color="#FF0000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBox Grid.Column="1" x:Name="ToolHexInput" Text="#F44336" FontSize="10" Padding="5,2" VerticalAlignment="Center" KeyDown="OnToolHexKeyDown" Margin="5,0,15,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- STICKER POPUP -->
            <Border x:Name="StickerPickerPopup" Visibility="Collapsed" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="10" Width="280">
                <StackPanel>
                    <Grid Margin="2,0,0,10">
                        <TextBlock Text="我的贴纸" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="ManageStickersBtn" Content="管理" HorizontalAlignment="Right" Click="OnManageStickersClick" Background="Transparent" Foreground="#00A2FF" BorderThickness="0" Cursor="Hand" Style="{StaticResource ToolbarButton}" Padding="5,0"/>
                    </Grid>
                    <ItemsControl x:Name="StickerItemsControl">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6">
                                    <Border Width="54" Height="54" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Background="#2C2C2C" Cursor="Hand" MouseDown="OnStickerItemMouseDown" Tag="{Binding}">
                                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Tag="ManageCheckBox" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,12,0,0">
                        <Button x:Name="UploadStickerBtn" Content="+ 批量上传贴纸" Background="#00A2FF" Foreground="White" Padding="0,10" Click="OnUploadStickerClick" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Grid x:Name="ManageStickerActionGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="删除选中" Background="#FF4444" Foreground="White" Margin="0,0,5,0" Padding="0,10" Click="OnDeleteSelectedStickersClick" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Grid.Column="1" Content="完成管理" Background="#444" Foreground="White" Margin="5,0,0,0" Padding="0,10" Click="OnFinishManageStickersClick" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
