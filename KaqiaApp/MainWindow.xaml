<Window x:Class="KaqiaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaqia Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        Left="0" Top="0"
        ShowInTaskbar="False">
    <Grid x:Name="RootGrid">
        <!-- Layer 1: The full screen screenshot -->
        <Image x:Name="BackgroundImg" Stretch="Fill" />
        
        <!-- Layer 2: The Dimming Mask -->
        <Path x:Name="MaskPath" Fill="#B0000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullRect" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionRect" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- Layer 3: Interaction Canvas -->
        <Canvas x:Name="MainCanvas" Background="Transparent" MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp">
            <!-- Selection Border -->
            <Rectangle x:Name="SelectionBorder" Stroke="#00A2FF" StrokeThickness="2" Visibility="Collapsed" />

            <!-- Layer 4: The Editing Window -->
            <Canvas x:Name="EditCanvas" Visibility="Collapsed">
                <Border x:Name="ImageBorder" Background="White" Padding="0">
                    <!-- Change: Using Canvas for stickers to prevent hit-test blocking -->
                    <Canvas x:Name="ImageContainer" Background="Transparent">
                        <Image x:Name="CroppedImage" Stretch="None" />
                        <!-- Stickers will be added here as Canvas children -->
                    </Canvas>
                </Border>
            </Canvas>
        </Canvas>

        <!-- Layer 5: Top-level Floating Toolbar (Moved outside to ensure hit-test) -->
        <StackPanel x:Name="Toolbar" Orientation="Horizontal" Visibility="Collapsed"
                    Background="#2C2C2C" Height="42" VerticalAlignment="Top" HorizontalAlignment="Left" Panel.ZIndex="9999">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="5,4"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4A4A4A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <Button Content="无边框" Click="OnNoBorderClick"/>
            <Button Content="拍立得" Click="OnPolaroidClick"/>
            <Button Content="阴影" Click="OnShadowClick"/>
            <Separator Width="1" Background="#444" Margin="5,8"/>
            <Button Content="加贴纸" Click="OnAddStickerClick"/>
            <Separator Width="1" Background="#444" Margin="5,8"/>
            <Button Content="完成" Click="OnFinishClick" Background="#00C853" FontWeight="Bold"/>
            <Button Content="取消" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
